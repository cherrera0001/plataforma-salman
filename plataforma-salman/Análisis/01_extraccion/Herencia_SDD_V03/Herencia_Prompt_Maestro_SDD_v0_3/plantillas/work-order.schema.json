{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:herencia:work-order:0.3",
  "title": "Contrato de trabajo de agente Herencia",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "mode",
    "feature_id",
    "baseline",
    "objective",
    "allowed_paths",
    "forbidden_paths",
    "tools",
    "requirements",
    "tasks",
    "tests_required",
    "reviewer",
    "authorization",
    "limits",
    "stop_conditions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^OT-[0-9]{3,}$"
    },
    "mode": {
      "enum": [
        "ESPECIFICAR",
        "PLANIFICAR_PAQUETE",
        "CONSTRUIR_PAQUETE"
      ]
    },
    "feature_id": {
      "type": "string",
      "pattern": "^F[0-9]{2}(?:-[a-z0-9-]+)?$"
    },
    "baseline": {
      "type": "object",
      "required": [
        "master_version",
        "source_hash",
        "constitution_version"
      ],
      "properties": {
        "master_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "constitution_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests_required": {
      "const": true
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "authorization": {
      "type": "object",
      "required": [
        "status",
        "approved_by",
        "approved_at",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "PENDIENTE",
            "AUTORIZADO",
            "REVOCADO"
          ]
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "max_corrective_cycles",
        "external_spend_authorized"
      ],
      "properties": {
        "max_corrective_cycles": {
          "type": "integer",
          "minimum": 1
        },
        "external_spend_authorized": {
          "type": "boolean"
        },
        "budget_amount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "budget_currency": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
