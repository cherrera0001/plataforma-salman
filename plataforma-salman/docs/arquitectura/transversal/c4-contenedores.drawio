<mxfile host="Electron" modified="2026-10-16T16:00:00.000Z" agent="PlataformaSalman/ArchitectureTeam" version="21.6.8" type="device"><diagram id="diag_c4_contenedores___plataforma_salman" name="C4 Contenedores - Plataforma Salman"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c_spa" value="&amp;lt;b&amp;gt;Single-Page App (Web &amp;amp; POS)&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;[Container: React / TypeScript]&amp;lt;br/&amp;gt;UI responsiva para punto de venta, gestión hotelera, CRM y control de obras" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2b8a3e;strokeColor=#1e622b;fontColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="80" y="140" width="240" height="90" as="geometry" /></mxCell><mxCell id="c_gw" value="&amp;lt;b&amp;gt;API Gateway &amp;amp; Auth Router&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;[Container: Reverse Proxy]&amp;lt;br/&amp;gt;Resuelve subdominio tenant, inyecta X-Tenant-ID y valida JWT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0e5499;fontColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="400" y="140" width="240" height="90" as="geometry" /></mxCell><mxCell id="c_svc" value="&amp;lt;b&amp;gt;Backend Services API&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;[Container: Node / Python / Go]&amp;lt;br/&amp;gt;Lógica de negocio, controladores REST y despacho de eventos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0e5499;fontColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="720" y="140" width="240" height="90" as="geometry" /></mxCell><mxCell id="c_db" value="&amp;lt;b&amp;gt;PostgreSQL Database&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;[Container: PostgreSQL 16+]&amp;lt;br/&amp;gt;Esquemas lógicos segregados (core, cafeteria, hotel, inmobiliaria, constructora) con RLS estricto" style="shape=cylinder3